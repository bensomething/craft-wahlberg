# Keep the dist package to what an installation needs. Everything listed here is
# for working on the plugin rather than with it, and every install downloading a
# test suite it will never run is bandwidth and disk spent on nothing.
#
# `src/config.php` deliberately stays: the README tells people to copy it.

/.gitattributes export-ignore
/.gitignore export-ignore
/ecs.php export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/tests export-ignore
