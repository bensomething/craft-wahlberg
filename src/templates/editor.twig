{#
    Macros for dropping the editor into your own templates.

        {% import 'wahlberg/editor' as wahlberg %}

        {{ wahlberg.field({
            label: 'Release Notes'|t('my-plugin'),
            instructions: 'Markdown, please.'|t('my-plugin'),
            name: 'notes',
            value: settings.notes,
            errors: settings.getErrors('notes'),
        }) }}

    `field()` wraps the editor in Craft’s own field chrome: label, instructions,
    errors, required marker. `input()` gives you the bare editor.

    Editor options (`toolbar`, `floating`, `buttons`, `preview`, `highlight`, `stats`,
    `flavour`, `fontSize`, `minRows`, `maxRows`, `placeholder`, `charLimit`,
    `byteLimit`, `refTags`, `assetSources`, `assetCriteria`, `snippets`,
    `inputAttributes`) can go in the same config. Anything else is passed through
    to Craft’s field macro.

    `buttons` takes the commands `Editor::commands()` lists, in any order — the
    toolbar keeps its own. Leaving it out gives you the same toolbar a Markdown
    field starts with.
#}

{% macro input(config) %}
    {{- wahlbergEditor(config) -}}
{% endmacro %}

{% macro field(config) %}
    {% import '_includes/forms' as forms %}
    {% set config = config|merge({
        id: config.id ?? "wahlberg-#{random()}",
    }) %}
    {{ forms.field(config, _self.input(config)) }}
{% endmacro %}
