{
    "name": "bensomething/craft-wahlberg",
    "description": "A Markdown field with a GitHub-style editor.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "plugin",
        "fields",
        "markdown",
        "editor"
    ],
    "support": {
        "issues": "https://github.com/bensomething/craft-wahlberg/issues",
        "source": "https://github.com/bensomething/craft-wahlberg"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "ezyang/htmlpurifier": "^4.17"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "bensomething\\wahlberg\\": "src/"
        }
    },
    "extra": {
        "handle": "wahlberg",
        "name": "Wahlberg",
        "developer": "Ben Smith",
        "developerUrl": "https://bensomething.com",
        "documentationUrl": "https://github.com/bensomething/craft-wahlberg",
        "changelogUrl": "https://raw.githubusercontent.com/bensomething/craft-wahlberg/develop/CHANGELOG.md",
        "class": "bensomething\\wahlberg\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit --colors=always",
        "test-js": "@php -r \"passthru('node tests/js/highlight.test.js');\""
    },
    "autoload-dev": {
        "psr-4": {
            "bensomething\\wahlberg\\tests\\": "tests/"
        }
    }
}
